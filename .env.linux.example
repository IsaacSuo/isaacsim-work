# Copy or source these values on the Linux render server.
export ISAAC_PYTHON=/opt/isaacsim/python.sh
export BLENDER_BIN=/usr/bin/blender
export FFMPEG_BIN=/usr/bin/ffmpeg
export SCENES_ROOT="$PWD/scenes"

# Isaac Sim normally needs its own Python launcher, not system python3.
export OMNI_KIT_ACCEPT_EULA=YES
