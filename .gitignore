# Generated simulation and render artifacts
output/
scenes/
BUNDLE_MANIFEST.sha256

# Large local model collection; curated runtime assets stay in assets/ root
assets/archieved_models/
assets/simulation_ready_models/
# Reproducible PhysX cooking proxies generated by tools/models/prepare_simulation_stls.py
assets/collision_cooking_models*/

# Python caches
__pycache__/
*.py[cod]

# Runtime logs and process markers
*.log
*.pid

# Temporary files
*.tmp
*.part

# Platform-specific native bridge build products.  Keep the C++ sources and
# test geometry in Git; every target machine must rebuild its own binary.
experiments/mountain_waterfall/native_bridge/build/
experiments/mountain_waterfall/native_bridge/bin/
*.lib
*.exp
*.pyd

# Historical ad-hoc copies are kept locally, not as active source
*.bak_*
